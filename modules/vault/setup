#!/bin/sh
set -eu

VAULT_ROOT="${VAULT_ROOT:-$HOME/.vault}"
VAULT_REMOTE="${VAULT_REMOTE:-repos:srv/git/vault.git}"

echo ":: Initializing Sovereign Vault at $VAULT_ROOT..."

# 1. Initialize repository if absent
if [ ! -d "$VAULT_ROOT/.git" ]; then
    echo ":: Checking access to remote $VAULT_REMOTE..."
    if git clone "$VAULT_REMOTE" "$VAULT_ROOT" 2>/dev/null; then
        echo "✓ Cloned vault successfully from $VAULT_REMOTE"
    else
        echo "------------------------------------------------------------------"
        echo " NOTICE: Could not clone vault from $VAULT_REMOTE"
        echo " Complete vault setup manually once identity keys are in place:"
        echo "   1. vault init $VAULT_REMOTE"
        echo "   2. OR restore cold backup: backup restore <seed.tar.gz.age> ~/.vault"
        echo "------------------------------------------------------------------"
        mkdir -p "$VAULT_ROOT"
        chmod 700 "$VAULT_ROOT"
        exit 0
    fi
else
    echo "✓ Vault Git repository already present."
    if git -C "$VAULT_ROOT" remote | grep -q "^origin$"; then
        git -C "$VAULT_ROOT" remote set-url origin "$VAULT_REMOTE"
    else
        git -C "$VAULT_ROOT" remote add origin "$VAULT_REMOTE"
    fi
fi

# 2. Strict permission enforcement delegated entirely to vault CLI
vault chmod

# 3. Apply target modules registered in .kv-store
TARGET_MODS=$(kv smembers "vault-modules" 2>/dev/null || true)

if [ -n "$TARGET_MODS" ]; then
    echo ":: Applying configured vault modules: $TARGET_MODS"
    for mod in $TARGET_MODS; do
        if [ -d "$VAULT_ROOT/$mod" ]; then
            vault apply "$mod"
            echo "  + Applied: $mod"
        else
            echo "  ! Skipping '$mod' (not present in $VAULT_ROOT)"
        fi
    done
fi

echo "✓ Vault setup complete."
