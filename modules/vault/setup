#!/bin/sh
set -eu

VAULT_ROOT="${VAULT_ROOT:-$HOME/.vault}"
VAULT_REMOTE="${VAULT_REMOTE:-repos:srv/git/vault.git}"

echo ":: Initializing Sovereign Vault at $VAULT_ROOT..."

# Case A: Vault is already a Git repository
if [ -d "$VAULT_ROOT/.git" ]; then
	echo "✓ Vault Git repository already present."
	if git -C "$VAULT_ROOT" remote | grep -q "^origin$"; then
		git -C "$VAULT_ROOT" remote set-url origin "$VAULT_REMOTE"
	else
		git -C "$VAULT_ROOT" remote add origin "$VAULT_REMOTE"
	fi

# Case B: Vault directory has raw files (cold seed/backup restore without .git)
elif [ -d "$VAULT_ROOT" ] && [ -n "$(ls -A "$VAULT_ROOT" 2>/dev/null)" ]; then
	echo ":: Found raw files without Git history. Initializing local repository..."
	git -C "$VAULT_ROOT" init -b main
	git -C "$VAULT_ROOT" remote add origin "$VAULT_REMOTE"

	if [ ! -f "$VAULT_ROOT/.gitignore" ]; then
		cat <<'GI' >"$VAULT_ROOT/.gitignore"
*.swp
*~
.DS_Store
GI
	fi

# Case C: Vault is empty or missing (attempt network clone if SSH keys exist)
else
	echo ":: No local vault found. Checking remote access to $VAULT_REMOTE..."
	if git clone "$VAULT_REMOTE" "$VAULT_ROOT" 2>/dev/null; then
		echo "✓ Cloned vault successfully from $VAULT_REMOTE"
	else
		echo "------------------------------------------------------------------"
		echo " NOTICE: Could not clone vault from $VAULT_REMOTE (SSH keys missing)."
		echo " Unpack your cold backup seed into $VAULT_ROOT:"
		echo "   backup restore <seed.tar.gz.age> $VAULT_ROOT"
		echo " Then re-run: make vault"
		echo "------------------------------------------------------------------"
		mkdir -p "$VAULT_ROOT"
		chmod 700 "$VAULT_ROOT"
		exit 0
	fi
fi

# 1. Enforce strict permissions across all vault files
vault chmod

# 2. Apply target modules registered in $VAULT_MODULES
TARGET_MODS="${VAULT_MODULES:-}"

if [ -n "$TARGET_MODS" ]; then
	echo ":: Applying configured vault modules: $TARGET_MODS"
	for mod in $TARGET_MODS; do
		if [ -d "$VAULT_ROOT/$mod" ]; then
			vault apply "$mod"
			echo "  + Applied: $mod"
		else
			echo "  ! Skipping '$mod' (not present in $VAULT_ROOT)"
		fi
	done
fi

echo "✓ Vault setup complete."
