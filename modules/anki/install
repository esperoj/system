#!/usr/bin/env bash
set -euo pipefail

ANKI_VER="26.08.1"
URL="https://github.com/ankitects/anki/releases/download/${ANKI_VER}/anki-${ANKI_VER}-linux-x86_64.tar.zst"
PREFIX="${HOME}/.local"

# Create temporary working area
TMP_DIR=$(mktemp -d -t anki-install-XXXXXX)
trap 'rm -rf "${TMP_DIR}"' EXIT

echo "Downloading Anki ${ANKI_VER}..."
curl -L -o "${TMP_DIR}/anki.tar.zst" "${URL}"

echo "Extracting archive..."
tar -xaf "${TMP_DIR}/anki.tar.zst" -C "${TMP_DIR}"

EXTRACTED_DIR="${TMP_DIR}/anki-linux"

echo "Installing application to ${PREFIX}/share/anki..."
mkdir -p "${PREFIX}/share/anki"
cp -ar "${EXTRACTED_DIR}"/* "${PREFIX}/share/anki/"

echo "Creating executable symlink in ${PREFIX}/bin..."
mkdir -p "${PREFIX}/bin"
ln -sf "${PREFIX}/share/anki/anki" "${PREFIX}/bin/anki"

echo "Configuring desktop shortcuts..."
mkdir -p "${PREFIX}/share/applications" "${PREFIX}/share/pixmaps"
cp -f "${EXTRACTED_DIR}/anki.png" "${PREFIX}/share/pixmaps/anki.png"

sed -e "s|Exec=anki|Exec=${PREFIX}/bin/anki|g" \
    -e "s|Icon=anki|Icon=${PREFIX}/share/pixmaps/anki.png|g" \
    "${EXTRACTED_DIR}/anki.desktop" > "${PREFIX}/share/applications/anki.desktop"

echo "Done! Anki installed to ${PREFIX}/bin/anki"
echo "Ensure '${PREFIX}/bin' is present in your \$PATH."
