#!/usr/bin/env bash
set -euo pipefail

. "${LIB_DIR}/sh/fetch.sh"

PREFIX="${HOME}/.local"
TMP_DIR=$(mktemp -d -t anki-install-XXXXXX)
trap 'rm -rf "${TMP_DIR}"' EXIT

echo ":: Resolving Anki release..."
URL=$(fetch_resolve_url "gh:ankitects/anki" "linux.*\.tar\.zst$")

echo ":: Downloading and extracting Anki..."
fetch_download "$URL" "${TMP_DIR}/anki.tar.zst"
fetch_extract "${TMP_DIR}/anki.tar.zst" "${TMP_DIR}"

EXTRACTED_DIR=$(find "${TMP_DIR}" -mindepth 1 -maxdepth 1 -type d -name "anki*" | head -n 1)

echo ":: Installing application assets..."
mkdir -p "${PREFIX}/share/anki" "${PREFIX}/bin" "${PREFIX}/share/applications" "${PREFIX}/share/pixmaps"
cp -ar "${EXTRACTED_DIR}"/* "${PREFIX}/share/anki/"
ln -sf "${PREFIX}/share/anki/anki" "${PREFIX}/bin/anki"

cp -f "${EXTRACTED_DIR}/anki.png" "${PREFIX}/share/pixmaps/anki.png"
sed -e "s|Exec=anki|Exec=${PREFIX}/bin/anki|g" \
	-e "s|Icon=anki|Icon=${PREFIX}/share/pixmaps/anki.png|g" \
	"${EXTRACTED_DIR}/anki.desktop" >"${PREFIX}/share/applications/anki.desktop"

echo "✓ Anki successfully installed to ${PREFIX}/bin/anki"
