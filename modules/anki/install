#!/usr/bin/env bash
# anki - install/update/uninstall the desktop app into ~/.local.
#
#   install (default)  skip when a working anki is already on PATH
#   update             refetch only when upstream serves a newer release
#                      (version key comparison, no redownload when latest)
#   uninstall          pure rm -- deliberately needs no lib.sh, so it keeps
#                      working after the lib module itself is unstowed
set -euo pipefail

MODE="${1:-install}"

PREFIX="${HOME}/.local"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/system/tools/anki"

usage() {
	echo "usage: anki/install {install|update|uninstall}" >&2
	exit 1
}

remove_anki() {
	rm -rf "${PREFIX}/share/anki" "${PREFIX}/bin/anki" \
		"${PREFIX}/share/applications/anki.desktop" \
		"${PREFIX}/share/pixmaps/anki.png" \
		"${STATE}"
	echo "✓ Anki removed from ${PREFIX}"
}

case "$MODE" in
uninstall)
	remove_anki
	exit 0
	;;
install | update) ;;
*) usage ;;
esac

LIB="${LIB_DIR:-$HOME/.local/lib}/sh/lib.sh"
[ -f "$LIB" ] || {
	echo "anki: lib.sh not found at $LIB (run 'make base' first)" >&2
	exit 1
}
# shellcheck source=/dev/null
. "$LIB"

# Map architecture to Anki release asset naming
case "$ARCH" in
amd64)
	ARCH_PATTERN="x86_64"
	;;
arm64)
	ARCH_PATTERN="aarch64"
	;;
*)
	echo "Error: Anki official binaries only support x86_64 and aarch64 (current: $ARCH)" >&2
	exit 1
	;;
esac

echo ":: Resolving Anki release for linux-${ARCH_PATTERN}..."
URL=$(fetch_resolve_url "gh:ankitects/anki" "linux-${ARCH_PATTERN}\.tar\.zst$")

if [ "$MODE" = update ]; then
	found=$(command -v anki 2>/dev/null || true)
	if [ -z "$found" ]; then
		echo "✓ Anki not installed; nothing to update"
		exit 0
	fi
	case "$found" in
	"$PREFIX"/bin/*) ;;
	*)
		echo "✓ Anki owned by the host ($found); its package manager updates it"
		exit 0
		;;
	esac
	if [ -s "$STATE" ] && [ "$(cat "$STATE")" = "$URL" ]; then
		echo "✓ Anki already latest"
		exit 0
	fi
else
	# Only skip if already installed AND executable on this CPU
	if command -v anki >/dev/null 2>&1 && anki --version >/dev/null 2>&1; then
		echo "✓ Anki is already installed and functional."
		exit 0
	fi
fi

TMP_DIR=$(mktemp -d -t anki-install-XXXXXX)
trap 'rm -rf "${TMP_DIR}"' EXIT

echo ":: Downloading and extracting Anki..."
fetch_download "$URL" "${TMP_DIR}/anki.tar.zst"
fetch_extract "${TMP_DIR}/anki.tar.zst" "${TMP_DIR}"

EXTRACTED_DIR=$(find "${TMP_DIR}" -mindepth 1 -maxdepth 1 -type d -name "anki*" | head -n 1)

echo ":: Cleaning previous installation..."
rm -rf "${PREFIX}/share/anki" "${PREFIX}/bin/anki"

echo ":: Installing application assets..."
mkdir -p "${PREFIX}/share/anki" "${PREFIX}/bin" "${PREFIX}/share/applications" "${PREFIX}/share/pixmaps"
cp -ar "${EXTRACTED_DIR}"/* "${PREFIX}/share/anki/"
ln -sf "${PREFIX}/share/anki/anki" "${PREFIX}/bin/anki"

if [ -f "${EXTRACTED_DIR}/anki.png" ]; then
	cp -f "${EXTRACTED_DIR}/anki.png" "${PREFIX}/share/pixmaps/anki.png"
fi

if [ -f "${EXTRACTED_DIR}/anki.desktop" ]; then
	sed -e "s|Exec=anki|Exec=${PREFIX}/bin/anki|g" \
		-e "s|Icon=anki|Icon=${PREFIX}/share/pixmaps/anki.png|g" \
		"${EXTRACTED_DIR}/anki.desktop" >"${PREFIX}/share/applications/anki.desktop"
fi

# Record the delivered release so update can skip an unchanged latest.
mkdir -p "$(dirname "$STATE")"
printf '%s\n' "$URL" >"$STATE"

echo "✓ Anki successfully installed to ${PREFIX}/bin/anki"
