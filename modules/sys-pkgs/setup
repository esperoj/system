#!/bin/sh
set -eu

. "${LIB_DIR}/sh/os.sh"

# 1. Identify Node Package Manager
case "$DISTRO" in
    termux)  MGR="pkg" ;;
    alpine)  MGR="apk" ;;
    debian)  MGR="apt" ;;
    freebsd) MGR="pkg" ;;
    *)
        echo "Notice: Unrecognized distro '$DISTRO'. Skipping system package manager." >&2
        exit 0
        ;;
esac

# 2. Check for root or sudo privileges (Termux skips sudo)
if [ "$DISTRO" != "termux" ] && [ "$(id -u)" -ne 0 ] && ! sudo -n true 2>/dev/null; then
    echo "Notice: Insufficient privileges (not root and no cached sudo). Skipping system packages." >&2
    exit 0
fi

# 3. Retrieve common packages + distro-specific packages from kv
COMMON_PKGS=$(kv smembers "common-pkgs" 2>/dev/null || true)
DISTRO_PKGS=$(kv smembers "${DISTRO}-pkgs" 2>/dev/null || true)

ALL_PKGS=$(printf '%s %s' "$COMMON_PKGS" "$DISTRO_PKGS" | tr -s ' ' | sed 's/^ //;s/ $//')

# 4. Perform bulk installation if packages are registered
if [ -n "$ALL_PKGS" ]; then
    echo ":: Installing system packages for [$DISTRO] via [$MGR]: $ALL_PKGS"
    # shellcheck disable=SC2086
    install-sys-pkg $ALL_PKGS
fi
