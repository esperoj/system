#!/bin/sh
set -eu

. "${LIB_DIR}/sh/os.sh"

if [ "$DISTRO" = "unknown" ]; then
    echo "Notice: Distro not managed via system packages. Skipping." >&2
    exit 0
fi

if [ "$DISTRO" != "termux" ] && [ "$(id -u)" -ne 0 ] && ! sudo -n true 2>/dev/null; then
    echo "Notice: Insufficient privileges (not root and no cached sudo). Skipping system packages." >&2
    exit 0
fi

# Configure parallel downloads for Debian
if [ "$DISTRO" = "debian" ]; then
    echo ":: Configuring APT parallel downloads..."
    APT_CONF="/etc/apt/apt.conf.d/99parallel"
    CONF_CONTENT='Acquire::http::Max-Future-Requests "10";
Acquire::https::Max-Future-Requests "10";
Acquire::Concurrent-Host-Downloads "4";'

    # Write config cleanly using sudo if non-root
    if [ "$(id -u)" -eq 0 ]; then
        printf '%s\n' "$CONF_CONTENT" > "$APT_CONF"
    else
        printf '%s\n' "$CONF_CONTENT" | sudo tee "$APT_CONF" >/dev/null
    fi
fi

# Retrieve ONLY standard common and distro-specific sets
COMMON_PKGS=$(kv smembers "common-pkgs" 2>/dev/null || true)
DISTRO_PKGS=$(kv smembers "${DISTRO}-pkgs" 2>/dev/null || true)

ALL_PKGS=$(printf '%s %s' "$COMMON_PKGS" "$DISTRO_PKGS" | tr -s ' ' | sed 's/^ //;s/ $//')

if [ -n "$ALL_PKGS" ]; then
    echo ":: Installing node dependencies for [$DISTRO]: $ALL_PKGS"
    # shellcheck disable=SC2086
    install-sys-pkg "$DISTRO" $ALL_PKGS
fi
