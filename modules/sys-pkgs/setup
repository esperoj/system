#!/bin/sh
set -eu

. "${LIB_DIR}/sh/os.sh"

case "$DISTRO" in
    termux)  MGR="pkg" ;;
    alpine)  MGR="apk" ;;
    debian)  MGR="apt" ;;
    freebsd) MGR="pkg" ;;
    *)
        echo "Notice: Distro '$DISTRO' not managed via system packages. Skipping." >&2
        exit 0
        ;;
esac

if [ "$DISTRO" != "termux" ] && [ "$(id -u)" -ne 0 ] && ! sudo -n true 2>/dev/null; then
    echo "Notice: Insufficient privileges (not root and no cached sudo). Skipping system packages." >&2
    exit 0
fi

# Retrieve ONLY standard common and distro-specific sets
COMMON_PKGS=$(kv smembers "common-pkgs" 2>/dev/null || true)
DISTRO_PKGS=$(kv smembers "${DISTRO}-pkgs" 2>/dev/null || true)

ALL_PKGS=$(printf '%s %s' "$COMMON_PKGS" "$DISTRO_PKGS" | tr -s ' ' | sed 's/^ //;s/ $//')

if [ -n "$ALL_PKGS" ]; then
    echo ":: Installing node dependencies for [$DISTRO] via [$MGR]: $ALL_PKGS"
    # shellcheck disable=SC2086
    install-sys-pkg $ALL_PKGS
fi
