#!/bin/sh
# install-sys-pkg - the single system-package installer.
#
#   Batch (from Make, no arguments): installs COMMON_PKGS plus the current
#   distro's set, both accumulated by the loaded modules.
#   Standalone: install-sys-pkg ripgrep tmux fzf installs ad hoc.
#
# Privilege model — stated once, used everywhere:
#   root or Termux  -> install directly
#   provable sudo   -> prefix the command. Provable means exactly one
#                      thing: `sudo -n -v` — non-interactive
#                      validation — succeeds. That covers passwordless
#                      sudo (containers) and a live credential cache (a
#                      terminal that already authenticated). The probe
#                      never prompts: it fails instead of asking.
#   otherwise       -> rootless host: loud skip, exit 0, so module-level
#                      user-local fallbacks (install-tool/fetch-bin) run.
#                      Nothing else is proof, on purpose: a sudo binary
#                      on PATH is the admins' tool (every pubnix has
#                      one), and a seat in sudo/wheel grants nothing an
#                      account can bank on — the sudoers grant may be
#                      absent, narrowed, or moot under a locked
#                      password, and /etc/sudoers is mode 0440.
#                      Anything that would need a prompt is treated as
#                      absent.
set -eu

LIB="${LIB_DIR:-$HOME/.local/lib}/sh/lib.sh"
[ -f "$LIB" ] || {
	echo "install-sys-pkg: lib.sh not found at $LIB (run 'make base' first)" >&2
	exit 1
}
# shellcheck source=/dev/null
. "$LIB"

# Determine packages to install
if [ $# -gt 0 ]; then
	PKGS="$*"
else
	case "$DISTRO" in
	debian) DISTRO_PKGS="${DEBIAN_PKGS:-}" ;;
	termux) DISTRO_PKGS="${TERMUX_PKGS:-}" ;;
	alpine) DISTRO_PKGS="${ALPINE_PKGS:-}" ;;
	freebsd) DISTRO_PKGS="${FREEBSD_PKGS:-}" ;;
	*) DISTRO_PKGS="" ;;
	esac
	PKGS="${COMMON_PKGS:-} ${DISTRO_PKGS}"
fi

# Deduplicate
# shellcheck disable=SC2086
PKGS=$(printf '%s\n' $PKGS | sort -u | tr '\n' ' ' | sed 's/^ //;s/ $//')
[ -n "$PKGS" ] || exit 0

echo ":: Installing system packages for [$DISTRO]: $PKGS"

# Privilege is probed non-interactively: `sudo -n -v` validates without
# prompting (it fails instead of asking), so this cannot hang an
# unattended run. It is also the ONLY honest proof, because it is sudo
# itself answering for this account, right now — not a guess from the
# PATH or the group database, both of which lie on shared hosts (a
# sudo binary belongs to the admins; a wheel/sudo group seat can carry
# no grant at all). Group membership was once read as privilege here
# and commissioning on a real pubnix prompted for a password that could
# never authenticate; that branch is gone.
if [ "$(id -u)" -eq 0 ] || [ "$DISTRO" = "termux" ]; then
	SUDO=""
elif command -v sudo >/dev/null 2>&1 && sudo -n -v 2>/dev/null; then
	SUDO="sudo"
else
	echo "install-sys-pkg: no usable root/sudo on [$DISTRO]; skipping system packages." >&2
	echo "install-sys-pkg: the host is expected to provide: $PKGS" >&2
	echo "install-sys-pkg: user-local fallbacks will be fetched where modules define them." >&2
	echo "install-sys-pkg: if this host is yours and you hold password sudo: 'sudo -v', then re-run." >&2
	exit 0
fi

case "$DISTRO" in
debian)
	export DEBIAN_FRONTEND=noninteractive
	$SUDO apt-get update -qq
	# shellcheck disable=SC2086
	$SUDO apt-get install -y --no-install-recommends --no-install-suggests $PKGS
	;;
termux)
	pkg update -y
	# shellcheck disable=SC2086
	pkg install -y $PKGS
	;;
alpine)
	$SUDO apk update -q
	# shellcheck disable=SC2086
	$SUDO apk add --no-cache $PKGS
	;;
freebsd)
	$SUDO pkg update
	# shellcheck disable=SC2086
	$SUDO pkg install -y $PKGS
	;;
*)
	echo "install-sys-pkg: unsupported distribution '$DISTRO'" >&2
	exit 1
	;;
esac

echo ":: Package installation complete."
