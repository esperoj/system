#!/bin/sh
# install-sys-pkg - standalone or batch package installer
set -eu
LIB="${LIB_DIR:-$HOME/.local/lib}/sh/os.sh"
[ -f "$LIB" ] || {
	echo "<script>: os.sh not found at $LIB (run 'make base' first)" >&2
	exit 1
}
# shellcheck source=/dev/null
. "$LIB"
# Determine packages to install
if [ $# -gt 0 ]; then
	PKGS="$*"
else
	distro_var="$(printf '%s_PKGS' "$DISTRO" | tr '[:lower:]' '[:upper:]')"
	eval "DISTRO_PKGS=\${$distro_var:-}"
	PKGS="${COMMON_PKGS:-} ${DISTRO_PKGS:-}"
fi

# Deduplicate
# shellcheck disable=SC2086
PKGS=$(printf '%s\n' $PKGS | sort -u | tr '\n' ' ' | sed 's/^ //;s/ $//')

[ -n "$PKGS" ] || exit 0

echo ":: Installing system packages for [$DISTRO]: $PKGS"

SUDO=""
if [ "$DISTRO" != "termux" ] && [ "$(id -u)" -ne 0 ]; then
	if command -v sudo >/dev/null 2>&1; then
		SUDO="sudo"
	else
		echo "Warning: Not root and 'sudo' unavailable. Installation may fail." >&2
	fi
fi

case "$DISTRO" in
debian)
	export DEBIAN_FRONTEND=noninteractive
	$SUDO apt-get update -qq
	# shellcheck disable=SC2086
	$SUDO apt-get install -y --no-install-recommends --no-install-suggests $PKGS
	;;
termux)
	pkg update -y
	# shellcheck disable=SC2086
	pkg install -y $PKGS
	;;
alpine)
	$SUDO apk update -q
	# shellcheck disable=SC2086
	$SUDO apk add --no-cache $PKGS
	;;
freebsd)
	$SUDO pkg update
	# shellcheck disable=SC2086
	$SUDO pkg install -y $PKGS
	;;
*)
	echo "install-sys-pkg: unsupported distribution '$DISTRO'" >&2
	exit 1
	;;
esac

echo ":: Package installation complete."
