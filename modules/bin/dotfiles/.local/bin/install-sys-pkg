#!/bin/sh
# install-sys-pkg - the single system-package installer.
#
#   Batch (from Make, no arguments): installs COMMON_PKGS plus the current
#   distro's set, both accumulated by the loaded modules.
#   Standalone: install-sys-pkg ripgrep tmux fzf installs ad hoc.
#
# Privilege model — stated once, used everywhere:
#   root or Termux     -> install directly
#   MACHINE_TYPE=pubnix -> rootless shared node: loud skip even though a
#                          sudo binary sits on PATH (it belongs to the
#                          host's admins; using it would only ask for a
#                          password the node must not be given)
#   sudo on PATH       -> prefix the command
#   otherwise          -> rootless host: loud skip, exit 0, so module-level
#                          user-local fallbacks (install-tool/fetch-bin) run
set -eu

LIB="${LIB_DIR:-$HOME/.local/lib}/sh/lib.sh"
[ -f "$LIB" ] || {
	echo "install-sys-pkg: lib.sh not found at $LIB (run 'make base' first)" >&2
	exit 1
}
# shellcheck source=/dev/null
. "$LIB"

# Determine packages to install
if [ $# -gt 0 ]; then
	PKGS="$*"
else
	case "$DISTRO" in
	debian) DISTRO_PKGS="${DEBIAN_PKGS:-}" ;;
	termux) DISTRO_PKGS="${TERMUX_PKGS:-}" ;;
	alpine) DISTRO_PKGS="${ALPINE_PKGS:-}" ;;
	freebsd) DISTRO_PKGS="${FREEBSD_PKGS:-}" ;;
	*) DISTRO_PKGS="" ;;
	esac
	PKGS="${COMMON_PKGS:-} ${DISTRO_PKGS}"
fi

# Deduplicate
# shellcheck disable=SC2086
PKGS=$(printf '%s\n' $PKGS | sort -u | tr '\n' ' ' | sed 's/^ //;s/ $//')
[ -n "$PKGS" ] || exit 0

echo ":: Installing system packages for [$DISTRO]: $PKGS"

if [ "$(id -u)" -eq 0 ] || [ "$DISTRO" = "termux" ]; then
	SUDO=""
elif [ "$MACHINE_TYPE" = "pubnix" ]; then
	echo "install-sys-pkg: MACHINE_TYPE=pubnix; skipping system packages (rootless shared node)." >&2
	echo "install-sys-pkg: the host is expected to provide: $PKGS" >&2
	echo "install-sys-pkg: user-local fallbacks will be fetched where modules define them." >&2
	exit 0
elif command -v sudo >/dev/null 2>&1; then
	SUDO="sudo"
else
	echo "install-sys-pkg: no root/sudo on [$DISTRO]; skipping system packages." >&2
	echo "install-sys-pkg: the host is expected to provide: $PKGS" >&2
	echo "install-sys-pkg: user-local fallbacks will be fetched where modules define them." >&2
	exit 0
fi

case "$DISTRO" in
debian)
	export DEBIAN_FRONTEND=noninteractive
	$SUDO apt-get update -qq
	# shellcheck disable=SC2086
	$SUDO apt-get install -y --no-install-recommends --no-install-suggests $PKGS
	;;
termux)
	pkg update -y
	# shellcheck disable=SC2086
	pkg install -y $PKGS
	;;
alpine)
	$SUDO apk update -q
	# shellcheck disable=SC2086
	$SUDO apk add --no-cache $PKGS
	;;
freebsd)
	$SUDO pkg update
	# shellcheck disable=SC2086
	$SUDO pkg install -y $PKGS
	;;
*)
	echo "install-sys-pkg: unsupported distribution '$DISTRO'" >&2
	exit 1
	;;
esac

echo ":: Package installation complete."
