#!/bin/sh
# vault - Ergonomic manager for sovereign unencrypted private Git repository
set -eu

VAULT_ROOT="${VAULT_ROOT:-$HOME/.vault}"

die() {
    echo "vault error: $*" >&2
    exit 1
}

require_vault() {
    [ -d "$VAULT_ROOT/.git" ] || die "Vault repository not found at '$VAULT_ROOT'. Run 'vault init' first."
}

# Automatically enforce strict private permissions:
# - Root and subdirectories: 0700 (owner rwx)
# - Regular files: 0600 (owner rw only)
# - Executable scripts: 0700 (owner rwx)
# - Prunes .git to avoid corrupting Git internal storage
enforce_permissions() {
    [ -d "$VAULT_ROOT" ] || return 0

    # 1. Enforce 0700 on vault root and all subdirectories
    chmod 700 "$VAULT_ROOT" 2>/dev/null || true
    find "$VAULT_ROOT" -name .git -prune -o -type d -exec chmod 700 {} + 2>/dev/null || true

    # 2. Enforce 0600 on files (0700 if executable)
    if find "$VAULT_ROOT" -maxdepth 0 -executable >/dev/null 2>&1; then
        find "$VAULT_ROOT" -name .git -prune -o -type f ! -executable -exec chmod 600 {} + 2>/dev/null || true
        find "$VAULT_ROOT" -name .git -prune -o -type f -executable -exec chmod 700 {} + 2>/dev/null || true
    else
        # Portable fallback
        find "$VAULT_ROOT" -name .git -prune -o -type f -exec chmod 600 {} + 2>/dev/null || true
    fi
}

# --- Subcommands ---

cmd_init() {
    if [ -d "$VAULT_ROOT/.git" ]; then
        echo "Vault already initialized at '$VAULT_ROOT'."
        enforce_permissions
        return 0
    fi

    mkdir -p "$VAULT_ROOT"
    chmod 700 "$VAULT_ROOT"

    if [ $# -gt 0 ]; then
        _remote="$1"
        echo ":: Cloning vault from $_remote..."
        git clone "$_remote" "$VAULT_ROOT"
    else
        echo ":: Initializing new private vault repository..."
        git -C "$VAULT_ROOT" init -b main
        
        # Enforce strict private file permissions in Git repo
        git -C "$VAULT_ROOT" config core.sharedRepository 0600
        cat <<'EOF' > "$VAULT_ROOT/.gitignore"
*.swp
*~
.DS_Store
EOF
        git -C "$VAULT_ROOT" add .gitignore
        git -C "$VAULT_ROOT" commit -m "chore: initialize sovereign vault"
    fi

    enforce_permissions
    echo "✓ Vault ready at $VAULT_ROOT (permissions locked to 600/700)"
}

cmd_sync() {
    require_vault
    cd "$VAULT_ROOT"

    echo ":: Synchronizing vault with remote..."
    if ! git remote | grep -q "^origin$"; then
        echo "Notice: No remote 'origin' configured. Skipping fetch/push."
        enforce_permissions
        return 0
    fi

    # Auto-commit tracked and untracked changes if any
    if [ -n "$(git status --porcelain)" ]; then
        echo ":: Staging and committing local changes..."
        git add -A
        git commit -m "sync: $(uname -n) snapshot $(date '+%Y-%m-%d %H:%M:%S')"
    fi

    git pull --rebase origin main 2>/dev/null || git pull --rebase origin master 2>/dev/null || true
    git push origin HEAD

    enforce_permissions
    echo "✓ Vault synchronized and permissions locked to 600."
}

cmd_apply() {
    require_vault
    [ $# -gt 0 ] || die "apply requires at least one module name. Available: $(cmd_ls)"

    # Lock down permissions before stow links files into $HOME
    enforce_permissions
    MODULES_DIR="$VAULT_ROOT" dot apply "$@"
}

cmd_remove() {
    require_vault
    [ $# -gt 0 ] || die "remove requires at least one module name."
    MODULES_DIR="$VAULT_ROOT" dot remove "$@"
}

cmd_ls() {
    require_vault
    # List top-level directories, ignoring .git and hidden dirs
    _mods=$(find "$VAULT_ROOT" -maxdepth 1 -mindepth 1 -type d ! -name ".*" -exec basename {} \; | sort | tr '\n' ' ')
    if [ -n "$_mods" ]; then
        echo "$_mods"
    else
        echo "(none)"
    fi
}

cmd_status() {
    require_vault
    cd "$VAULT_ROOT"
    echo "=== Vault Repository Status ($VAULT_ROOT) ==="
    git status -s
    echo "=== Available Modules ==="
    cmd_ls
}

cmd_diff() {
    require_vault
    git -C "$VAULT_ROOT" diff "$@"
}

cmd_chmod() {
    require_vault
    echo ":: Enforcing 600/700 permissions across $VAULT_ROOT..."
    enforce_permissions
    echo "✓ All files locked to 600, directories locked to 700."
}

cmd_cd() {
    require_vault
    echo "Entering vault shell at $VAULT_ROOT (exit to return)..."
    (cd "$VAULT_ROOT" && "${SHELL:-/bin/sh}")
}

# --- Router ---
case "${1:-}" in
    init)   shift; cmd_init "$@" ;;
    sync)   shift; cmd_sync "$@" ;;
    apply)  shift; cmd_apply "$@" ;;
    remove) shift; cmd_remove "$@" ;;
    status) shift; cmd_status "$@" ;;
    diff)   shift; cmd_diff "$@" ;;
    chmod)  shift; cmd_chmod ;;
    ls)     shift; cmd_ls ;;
    cd)     shift; cmd_cd ;;
    *)
        cat <<EOF
vault - Sovereign Private Git Manager

Usage:
  vault init [remote-url]     Initialize ~/.vault (or clone from VPS)
  vault sync                  Commit local changes, pull --rebase, push to VPS
  vault apply <module...>     Lock to 600 and link module dotfiles via stow
  vault remove <module...>    Unlink module dotfiles
  vault chmod                 Manually enforce 600 (files) and 700 (dirs)
  vault status                Show modified files and available modules
  vault diff                  Show git diff of uncommitted changes
  vault ls                    List available private modules
  vault cd                    Spawn a subshell inside ~/.vault
EOF
        exit 1
        ;;
esac
