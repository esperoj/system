#!/bin/sh
# vault - minimal manager for sovereign ~/.vault Git repository
set -eu

VAULT_ROOT="${VAULT_ROOT:-$HOME/.vault}"

die() {
	echo "vault: $*" >&2
	exit 1
}
require_vault() { [ -d "$VAULT_ROOT/.git" ] || die "no vault at $VAULT_ROOT — run: vault init"; }

# Clamps permissions: directories 700, files 600/700 (owner rw, keep x, go-rwx)
lock_perms() {
	[ -d "$VAULT_ROOT" ] || return 0
	chmod 700 "$VAULT_ROOT"
	find "$VAULT_ROOT" -name .git -prune -o -type d -exec chmod 700 {} +
	find "$VAULT_ROOT" -name .git -prune -o -type f -exec chmod u+rw,go-rwx {} +
}

cmd_init() {
	if [ -d "$VAULT_ROOT/.git" ]; then
		[ $# -ge 1 ] && (git -C "$VAULT_ROOT" remote set-url origin "$1" 2>/dev/null || git -C "$VAULT_ROOT" remote add origin "$1")
	elif [ -n "$(ls -A "$VAULT_ROOT" 2>/dev/null || true)" ]; then
		# Adopt cold seed / restored files in-place
		git -C "$VAULT_ROOT" init -b main
		[ $# -ge 1 ] && git -C "$VAULT_ROOT" remote add origin "$1"
	elif [ $# -ge 1 ]; then
		git clone "$1" "$VAULT_ROOT"
	else
		mkdir -p "$VAULT_ROOT"
		git -C "$VAULT_ROOT" init -b main
	fi
	lock_perms
	echo "vault: ready at $VAULT_ROOT"
}

cmd_sync() {
	require_vault
	(
		cd "$VAULT_ROOT"
		git add -A
		if ! git diff --cached --quiet; then
			git commit -m "vault: $(uname -n) $(date '+%F %T')"
		fi
		if git remote | grep -q .; then
			git pull --rebase --autostash 2>/dev/null || true
			git push -u origin HEAD 2>/dev/null || true
		fi
	)
	lock_perms
	echo "vault: synced"
}

cmd_apply() {
	require_vault
	lock_perms
	for m in "$@"; do
		if [ -d "$VAULT_ROOT/$m" ]; then
			MODULES_DIR="$VAULT_ROOT" dot apply "$m"
		fi
	done
	lock_perms
}

cmd_remove() {
	require_vault
	for m in "$@"; do
		if [ -d "$VAULT_ROOT/$m" ]; then
			MODULES_DIR="$VAULT_ROOT" dot remove "$m"
		fi
	done
}

case "${1:-}" in
init)
	shift
	cmd_init "$@"
	;;
sync) cmd_sync ;;
apply)
	shift
	[ $# -ge 1 ] || die "usage: vault apply <module...>"
	cmd_apply "$@"
	;;
remove)
	shift
	[ $# -ge 1 ] || die "usage: vault remove <module...>"
	cmd_remove "$@"
	;;
chmod)
	require_vault
	lock_perms
	echo "vault: permissions locked"
	;;
ls)
	require_vault
	MODULES_DIR="$VAULT_ROOT" dot ls
	;;
git)
	require_vault
	shift
	git -C "$VAULT_ROOT" "$@"
	;;
*) die "usage: vault {init [remote]|sync|apply|remove|chmod|ls|git ...}" ;;
esac
