#!/bin/bash
set -euo pipefail

LOG_DIR="$HOME/log/daily-cron"
LOG_FILE="$LOG_DIR/$(date -I).log"

mkdir -p "$LOG_DIR"
# shellcheck source=/dev/null
. ~/.profile

sync_rc=0
backup_rc=0

# The daily routine is sync first, backup second: sync commits and
# pushes the safe set (vault, notes, the pkit data repos), reports what
# needs a human, and only then the backup runs — capturing freshly
# pushed state. A failed sync is loud in the log but never skips the
# backup: the two phases are independent, and the backup is the one
# that must always happen.
sync 2>&1 | tee -a "$LOG_FILE" >&2 || sync_rc=1

make \
	--keep-going \
	--output-sync=target \
	-j \
	-f "$HOME/recipes/backup.mk" \
	daily 2>&1 | tee -a "$LOG_FILE" >&2 || backup_rc=1

# One email when either phase failed: the log already carries the
# detail, so the body only names the failed phase(s) and the log's
# path. A failed notify stays loud in the log but never changes the
# verdict below — the phases' own exit codes are the routine's answer.
phases=""
if [ "$sync_rc" -ne 0 ]; then
	phases="sync"
fi
if [ "$backup_rc" -ne 0 ]; then
	phases="${phases:+$phases }backup"
fi
if [ -n "$phases" ]; then
	if ! notify "daily on $(uname -n): $phases failed - log: $LOG_FILE" \
		"Subject: [system] daily failed on $(uname -n)"; then
		echo "daily: notify failed" >&2
	fi
fi

exit $((sync_rc || backup_rc))
