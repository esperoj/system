#!/usr/bin/env bash
set -euo pipefail

[ $# -ge 1 ] || { echo "usage: notify <data> [header...]" >&2; exit 1; }

data=$1
shift

args=(-SsfL -H "Content-Type: text/plain")

for header in "$@"; do
  args+=(-H "$header")
done

: "${NTFY_URL:?NTFY_URL must be set}"

curl "${args[@]}" -d "$data" "$NTFY_URL"
