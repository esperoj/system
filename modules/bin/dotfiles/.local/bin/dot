#!/bin/sh
# dot - minimal module manager on top of GNU Stow
#
#   dot apply <module...>   stash conflicts, then stow
#   dot remove <module...>  unstow
#   dot ls                  list modules
#
# Conflict policy: never delete, never scatter .bak files. Anything in the
# way is moved into $MODULES_DIR/.backup/<module>/ and tracked by git.
# Review with `git status`, merge what you want, delete the stash.
#
# env: MODULES_DIR (stow dir, default .), TARGET (default $HOME),
#      STOW_OPTS (extra stow flags, default -v)
set -eu

MODULES_DIR="${MODULES_DIR:-.}"
TARGET="${TARGET:-$HOME}"
STOW_OPTS="${STOW_OPTS:--v}"

die() {
	echo "dot: $*" >&2
	exit 1
}

[ -d "$MODULES_DIR" ] || die "modules dir not found: $MODULES_DIR"
[ -d "$TARGET" ] || die "target dir not found: $TARGET"
MODULES_DIR=$(cd "$MODULES_DIR" && pwd -P)
TARGET=$(cd "$TARGET" && pwd -P)

# One stow at a time (make -j runs applies in parallel)
LOCK="${XDG_STATE_HOME:-$HOME/.local/state}/dot.lock"
mkdir -p "$(dirname "$LOCK")"
exec 9>"$LOCK"
if command -v flock >/dev/null 2>&1; then
	flock -w 60 9 || die "could not acquire stow lock"
fi

canonicalize() {
	_path="$1"
	if command -v realpath >/dev/null 2>&1; then
		realpath "$_path" 2>/dev/null && return 0
	fi
	if _out=$(readlink -f "$_path" 2>/dev/null) && [ -n "$_out" ]; then
		printf '%s\n' "$_out"
		return 0
	fi
	while [ -L "$_path" ]; do
		_link=$(readlink "$_path" 2>/dev/null) || break
		case "$_link" in
		/*) _path="$_link" ;;
		*) _path="$(cd "$(dirname "$_path")" 2>/dev/null && pwd -P)/$_link" ;;
		esac
	done
	if [ -d "$_path" ]; then
		(cd "$_path" 2>/dev/null && pwd -P)
	elif [ -d "$(dirname "$_path")" ]; then
		printf '%s/%s\n' "$(cd "$(dirname "$_path")" 2>/dev/null && pwd -P)" "$(basename "$_path")"
	else
		printf '%s\n' "$_path"
	fi
}

# Returns 0 if $tgt is already pointing to $src or belongs to this MODULES_DIR
is_ours() {
	_tgt="$1"
	_src="$2"

	_tgt_canon=$(canonicalize "$_tgt")
	_src_canon=$(canonicalize "$_src")

	if [ -n "$_tgt_canon" ] && [ -n "$_src_canon" ] && [ "$_tgt_canon" = "$_src_canon" ]; then
		return 0
	fi

	case "$_tgt_canon" in
	"$MODULES_DIR" | "$MODULES_DIR"/*) return 0 ;;
	esac

	if [ -L "$_tgt" ]; then
		_raw=$(readlink "$_tgt" 2>/dev/null || true)
		case "$_raw" in
		"$MODULES_DIR" | "$MODULES_DIR"/*) return 0 ;;
		esac
	fi

	return 1
}

# Returns 0 if $tgt is a symlink pointing to any managed system repo or vault module
is_repo_symlink() {
	_tgt="$1"
	[ -L "$_tgt" ] || return 1

	_canon=$(canonicalize "$_tgt")
	case "$_canon" in
	*"/.vault"/* | *"/system/modules"/* | *"/projects/system"/*) return 0 ;;
	esac

	_raw=$(readlink "$_tgt" 2>/dev/null || true)
	case "$_raw" in
	*"/.vault/"* | *"/system/modules/"* | *"/projects/system/"*) return 0 ;;
	esac

	return 1
}

# Safely back up a conflicting host file to $MODULES_DIR/.backup/
stash_file() {
	_mod="$1"
	_rel="$2"
	_tgt="$3"

	_bak="$MODULES_DIR/.backup/$_mod/$_rel"
	_parent="$(dirname "$_bak")"

	if [ -L "$_parent" ]; then
		rm -f "$_parent"
	fi

	mkdir -p "$_parent"

	if [ -e "$_bak" ] || [ -L "$_bak" ]; then
		_bak="${_bak}.$(date +%Y%m%d%H%M%S)"
	fi

	mv "$_tgt" "$_bak"
	echo "dot: stashed $_tgt -> $_bak"
}

# Unfold directory symlinks and handle conflicts
stash() {
	for mod in "$@"; do
		[ -d "$MODULES_DIR/$mod" ] || die "no such module: $mod"
		(cd "$MODULES_DIR/$mod" && find . -name .git -prune -o -name .backup -prune -o -print) |
			while IFS= read -r rel || [ -n "$rel" ]; do
				rel=${rel#./}
				case "$rel" in
				'' | . | .. | .git | .git/* | .backup | .backup/* | .module-* | *.swp | *~ | .DS_Store) continue ;;
				esac

				src="$MODULES_DIR/$mod/$rel"
				tgt="$TARGET/$rel"

				[ -e "$tgt" ] || [ -L "$tgt" ] || continue

				# 1. Source is a directory
				if [ -d "$src" ] && [ ! -L "$src" ]; then
					# Target is already a real directory -> clean merge
					if [ -d "$tgt" ] && [ ! -L "$tgt" ]; then
						continue
					fi

					# Target is a folded directory symlink -> unfold into real directory
					if [ -L "$tgt" ] && [ -d "$tgt" ]; then
						_dest=$(readlink -f "$tgt" 2>/dev/null || true)
						rm -f "$tgt"
						mkdir -p "$tgt"
						if [ -n "$_dest" ] && [ -d "$_dest" ]; then
							for _item in "$_dest"/* "$_dest"/.[!.]* "$_dest"/..?*; do
								[ -e "$_item" ] || [ -L "$_item" ] || continue
								ln -sf "$_item" "$tgt/$(basename "$_item")"
							done
						fi
						continue
					fi

					# Target is a file blocking a directory -> stash it
					stash_file "$mod" "$rel" "$tgt"
					mkdir -p "$tgt"
					continue
				fi

				# 2. Source is a file
				if is_ours "$tgt" "$src"; then
					continue
				fi

				# If target points to another internal repo/vault module:
				# Replace symlink cleanly without creating .backup clutter
				if is_repo_symlink "$tgt"; then
					rm -f "$tgt"
					continue
				fi

				# Genuine unmanaged host file conflict -> stash it
				stash_file "$mod" "$rel" "$tgt"
			done
	done
}

stow_run() {
	action=$1
	shift
	# shellcheck disable=SC2086
	stow "$action" $STOW_OPTS --no-folding -d "$MODULES_DIR" -t "$TARGET" \
		--ignore='\.git' --ignore='\.swp$' --ignore='^\.module-' --ignore='^\.backup' "$@"
}

case "${1:-}" in
apply)
	shift
	[ $# -ge 1 ] || die "usage: dot apply <module...>"
	stash "$@"
	stow_run -S "$@"
	;;
remove)
	shift
	[ $# -ge 1 ] || die "usage: dot remove <module...>"
	stow_run -D "$@"
	;;
ls)
	find "$MODULES_DIR" -mindepth 1 -maxdepth 1 -type d ! -name '.*' \
		-exec basename {} \; | LC_ALL=C sort
	;;
*)
	die "usage: dot {apply|remove|ls} [module...]"
	;;
esac
