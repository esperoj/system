#!/bin/sh
# dot - minimal module manager on top of GNU Stow
#
#   dot apply <module...>   stash conflicts, then stow
#   dot remove <module...>  unstow
#   dot ls                  list modules
#
# Conflict policy: never delete, never scatter .bak files. Anything in the
# way is moved into $MODULES_DIR/.backup/<module>/ and tracked by git.
# Review with `git status`, merge what you want, delete the stash.
#
# env: MODULES_DIR (stow dir, default .), TARGET (default $HOME),
#      STOW_OPTS (extra stow flags, default -v)
set -eu

MODULES_DIR="${MODULES_DIR:-.}"
TARGET="${TARGET:-$HOME}"
STOW_OPTS="${STOW_OPTS:--v}"

die() { echo "dot: $*" >&2; exit 1; }

[ -d "$MODULES_DIR" ] || die "modules dir not found: $MODULES_DIR"
[ -d "$TARGET" ] || die "target dir not found: $TARGET"
MODULES_DIR=$(cd "$MODULES_DIR" && pwd -P)
TARGET=$(cd "$TARGET" && pwd -P)

# one stow at a time (make -j runs applies in parallel)
LOCK="${XDG_STATE_HOME:-$HOME/.local/state}/dot.lock"
mkdir -p "$(dirname "$LOCK")"
exec 9>"$LOCK"
if command -v flock >/dev/null 2>&1; then
    flock -w 60 9 || die "could not acquire stow lock"
fi

is_ours() { # symlink managed by this MODULES_DIR
    [ -L "$1" ] || return 1
    case "$(readlink -f "$1" 2>/dev/null)" in
    "$MODULES_DIR"/*) return 0 ;;
    esac
    return 1
}

# move whatever in TARGET blocks the packages into the repo
stash() {
    for pkg in "$@"; do
        [ -d "$MODULES_DIR/$pkg" ] || die "no such module: $pkg"
        (cd "$MODULES_DIR/$pkg" && find . -name .git -prune -o -print) |
        while IFS= read -r rel; do
            rel=${rel#./}
            case "$rel" in
            '' | . | .. | .git | .module-* | *.swp | *~ | .DS_Store) continue ;;
            esac
            src="$MODULES_DIR/$pkg/$rel"
            tgt="$TARGET/$rel"
            [ -e "$tgt" ] || [ -L "$tgt" ] || continue   # nothing in the way
            is_ours "$tgt" && continue                   # already linked by us
            [ -d "$tgt" ] && [ -d "$src" ] && continue   # real dirs merge fine
            bak="$MODULES_DIR/.backup/$pkg/$rel"
            if [ -e "$bak" ]; then
                echo "dot: stash exists: $bak — resolve it; stow will report $tgt" >&2
                continue
            fi
            mkdir -p "$(dirname "$bak")"
            mv "$tgt" "$bak"
            echo "dot: stashed $tgt -> $bak"
        done
    done
}

stow_run() { # $1 = stow | -D
    action=$1
    shift
    # shellcheck disable=SC2086
    stow $action $STOW_OPTS -d "$MODULES_DIR" -t "$TARGET" \
        --ignore='\.git' --ignore='\.swp$' --ignore='^\.module-' "$@"
}

case "${1:-}" in
apply)
    shift
    [ $# -ge 1 ] || die "usage: dot apply <module...>"
    stash "$@"
    stow_run stow "$@"
    ;;
remove)
    shift
    [ $# -ge 1 ] || die "usage: dot remove <module...>"
    stow_run -D "$@"
    ;;
ls)
    find "$MODULES_DIR" -mindepth 1 -maxdepth 1 -type d ! -name '.*' \
        -exec basename {} \; | LC_ALL=C sort
    ;;
*)
    die "usage: dot {apply|remove|ls} [module...]"
    ;;
esac
