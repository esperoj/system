#!/bin/sh
# dot - minimal Stow wrapper with conflict-safe host backup
set -eu

MODULES_DIR="${MODULES_DIR:-.}"
TARGET="${TARGET:-$HOME}"
BACKUP_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dot/backup"

die() {
	echo "dot: $*" >&2
	exit 1
}

[ -d "$MODULES_DIR" ] || die "modules dir not found: $MODULES_DIR"
[ -d "$TARGET" ] || die "target dir not found: $TARGET"
MODULES_DIR=$(cd "$MODULES_DIR" && pwd -P)
TARGET=$(cd "$TARGET" && pwd -P)

# Concurrency lock for parallel Make (-j)
LOCK="${XDG_STATE_HOME:-$HOME/.local/state}/dot.lock"
mkdir -p "$(dirname "$LOCK")"
exec 9>"$LOCK"
if command -v flock >/dev/null 2>&1; then
	flock -w 60 9 || die "could not acquire lock"
fi

# Prepare TARGET: resolve conflicts before Stow runs
stash() {
	for mod in "$@"; do
		[ -d "$MODULES_DIR/$mod" ] || die "no such module: $mod"
		(cd "$MODULES_DIR/$mod" && find . -type f ! -name '.*.swp' ! -name '*~' ! -name '.DS_Store') | while IFS= read -r rel || [ -n "$rel" ]; do
			rel="${rel#./}"
			src="$MODULES_DIR/$mod/$rel"
			tgt="$TARGET/$rel"

			if [ -L "$tgt" ]; then
				# If already pointing to this source file, no-op
				[ "$tgt" -ef "$src" ] && continue
				# Stale or overridden symlink: remove pointer so Stow links cleanly
				rm -f "$tgt"
			elif [ -e "$tgt" ]; then
				# Genuine unmanaged host file blocking Stow: back it up once
				mkdir -p "$BACKUP_DIR/$(dirname "$rel")"
				mv "$tgt" "$BACKUP_DIR/$rel"
				echo "dot: backed up $tgt -> $BACKUP_DIR/$rel"
			fi
		done
	done
}

case "${1:-}" in
apply)
	shift
	[ $# -ge 1 ] || die "usage: dot apply <module...>"
	stash "$@"
	stow -S -v --no-folding -d "$MODULES_DIR" -t "$TARGET" "$@"
	;;
remove)
	shift
	[ $# -ge 1 ] || die "usage: dot remove <module...>"
	stow -D -v --no-folding -d "$MODULES_DIR" -t "$TARGET" "$@"
	;;
ls)
	find "$MODULES_DIR" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -exec basename {} \; | LC_ALL=C sort
	;;
*)
	die "usage: dot {apply|remove|ls} [module...]"
	;;
esac
