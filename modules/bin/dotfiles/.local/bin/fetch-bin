#!/bin/sh
# fetch-bin - Universal POSIX binary installer for direct URLs and GitHub releases
set -eu

USAGE="Usage: fetch-bin <url|gh:owner/repo> [asset-regex-or-pattern] [binary-name] [dest-path]"

[ $# -lt 1 ] && { echo "$USAGE" >&2; exit 1; }

SOURCE="$1"
PATTERN="${2:-}"
BIN_NAME="${3:-}"
DEST_PATH="${4:-$HOME/.local/bin}"

# Source the engine
LIB_DIR="${LIB_DIR:-$HOME/.local/lib}"
if [ -f "${LIB_DIR}/sh/fetch.sh" ]; then
    . "${LIB_DIR}/sh/fetch.sh"
else
    # Fallback to relative script location
    _self_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
    . "${_self_dir}/../../../lib/dotfiles/.local/lib/sh/fetch.sh"
fi

TMP_DIR=$(mktemp -d -t fetch-bin-XXXXXX)
trap 'rm -rf "${TMP_DIR}"' EXIT

echo ":: Resolving $SOURCE..."
URL=$(fetch_resolve_url "$SOURCE" "$PATTERN")

# Infer filename and download
FILE_NAME=$(basename "${URL%%\?*}")
ARCHIVE="${TMP_DIR}/${FILE_NAME}"

echo ":: Downloading $URL..."
fetch_download "$URL" "$ARCHIVE"

EXTRACT_DIR="${TMP_DIR}/extracted"
echo ":: Extracting $FILE_NAME..."
fetch_extract "$ARCHIVE" "$EXTRACT_DIR"

# Determine target binary name
if [ -z "$BIN_NAME" ]; then
    # If no binary name given, infer from source or archive
    case "$SOURCE" in
        gh:*) BIN_NAME=$(basename "${SOURCE#gh:}") ;;
        *)    BIN_NAME=$(basename "$FILE_NAME" | sed -E 's/\.(tar\.(gz|xz|zst|bz2)|zip|bz2|gz)$//') ;;
    esac
fi

# Locate the binary in the extracted contents
FOUND_BIN=$(find "$EXTRACT_DIR" -type f -name "$BIN_NAME" | head -n 1)

# If not found by exact name (e.g. raw executable or single file), look for any executable or single file
if [ -z "$FOUND_BIN" ]; then
    FOUND_BIN=$(find "$EXTRACT_DIR" -type f ! -name "*.txt" ! -name "*.md" | head -n 1)
fi

[ -z "$FOUND_BIN" ] && { echo "Error: Could not locate target binary '$BIN_NAME' in archive" >&2; exit 1; }

# Install to destination
mkdir -p "$(dirname "$DEST_PATH")"
if [ -d "$DEST_PATH" ]; then
    TARGET="${DEST_PATH}/${BIN_NAME}"
else
    TARGET="$DEST_PATH"
fi

cp -f "$FOUND_BIN" "$TARGET"
chmod 755 "$TARGET"
echo "✓ Successfully installed $TARGET"
