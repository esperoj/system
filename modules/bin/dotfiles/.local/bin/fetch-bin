#!/bin/sh
# fetch-bin - Universal POSIX binary installer for direct URLs and GitHub releases
set -eu

USAGE="Usage: fetch-bin <url|gh:owner/repo> [asset-regex] [binary-name] [dest-path]"
[ $# -lt 1 ] && {
	echo "$USAGE" >&2
	exit 1
}

SOURCE="$1"
PATTERN="${2:-}"
BIN_NAME="${3:-}"
DEST_PATH="${4:-$HOME/.local/bin}"

# Standard library resolution: $LIB_DIR (set by Make or bootstrap) or the
# installed path.
LIB="${LIB_DIR:-$HOME/.local/lib}/sh/lib.sh"
[ -f "$LIB" ] || {
	echo "fetch-bin: lib.sh not found at $LIB (run 'make base' first)" >&2
	exit 1
}
# shellcheck source=/dev/null
. "$LIB"

TMP_DIR=$(mktemp -d -t fetch-bin-XXXXXX)
trap 'rm -rf "${TMP_DIR}"' EXIT

echo ":: Resolving $SOURCE..."
URL=$(fetch_resolve_url "$SOURCE" "$PATTERN")

echo ":: Downloading $URL..."
fetch_download "$URL" "${TMP_DIR}/download"

# Name the archive. The requested basename wins when it already looks like
# a file; a generic one ("latest" from dl.filippo.io) hides the real asset
# name behind a redirect, so probe once and follow the whole chain — a
# single hop is not enough on multi-hop CDNs (matching install-tool).
FILE_NAME=$(basename "${URL%%\?*}")
case "$FILE_NAME" in
*.tar.gz | *.tgz | *.tar.xz | *.tar.zst | *.tar.bz2 | *.zip | *.bz2 | *.gz) ;;
*)
	_redirect=$(curl -fsSIL -o /dev/null -w '%{url_effective}' "$URL" 2>/dev/null || true)
	_candidate=$(basename "${_redirect%%\?*}")
	case "$_candidate" in
	*.tar.gz | *.tgz | *.tar.xz | *.tar.zst | *.tar.bz2 | *.zip | *.bz2 | *.gz)
		FILE_NAME="$_candidate"
		;;
	esac
	;;
esac
ARCHIVE="${TMP_DIR}/${FILE_NAME}"
mv -f "${TMP_DIR}/download" "$ARCHIVE"

EXTRACT_DIR="${TMP_DIR}/extracted"

echo ":: Extracting $FILE_NAME..."
fetch_extract "$ARCHIVE" "$EXTRACT_DIR"

# Determine target binary name
if [ -z "$BIN_NAME" ]; then
	case "$SOURCE" in
	gh:*)
		BIN_NAME=$(basename "${SOURCE#gh:}")
		;;
	*)
		BIN_NAME=$(basename "$FILE_NAME" | sed -E 's/\.(tar\.(gz|xz|zst|bz2)|zip|bz2|gz)$//')
		;;
	esac
fi

FOUND_BIN=""

# 1. Prefer an exact name match anywhere in the archive.
if [ -n "$BIN_NAME" ]; then
	FOUND_BIN=$(find "$EXTRACT_DIR" -type f -name "$BIN_NAME" | LC_ALL=C sort | head -n 1)
fi

# 2. Otherwise require exactly one candidate: an executable file if the
#    archive marks any, else the archive's only regular file. Archives with
#    several plausible files fail loudly with the candidate list.
if [ -z "$FOUND_BIN" ]; then
	CANDIDATES=$(find "$EXTRACT_DIR" -type f -perm -u+x | LC_ALL=C sort)
	[ -n "$CANDIDATES" ] || CANDIDATES=$(find "$EXTRACT_DIR" -type f | LC_ALL=C sort)

	if [ -z "$CANDIDATES" ]; then
		echo "fetch-bin: no regular files found in archive" >&2
		exit 1
	fi

	COUNT=$(printf '%s\n' "$CANDIDATES" | grep -c .)

	if [ "$COUNT" -eq 1 ]; then
		FOUND_BIN=$CANDIDATES
	else
		echo "fetch-bin: ambiguous archive; specify [binary-name] explicitly:" >&2
		printf '%s\n' "$CANDIDATES" | sed 's/^/  /' >&2
		exit 1
	fi
fi

# Install to destination. An explicit [dest-path] may name the file
# itself, so only its parent is created; the default names the
# user's bin directory and is created as such, so a fresh HOME
# never gets a regular file called "bin" where the directory
# should be.
if [ -n "${4:-}" ]; then
	mkdir -p "$(dirname "$4")"
else
	mkdir -p "$DEST_PATH"
fi

if [ -d "$DEST_PATH" ]; then
	TARGET="${DEST_PATH%/}/${BIN_NAME}"
else
	TARGET="$DEST_PATH"
fi

cp -f "$FOUND_BIN" "$TARGET"
chmod 755 "$TARGET"

echo "✓ Successfully installed $TARGET"
