#!/bin/sh
# fetch-bin - Universal POSIX binary installer for direct URLs and GitHub releases
set -eu

USAGE="Usage: fetch-bin <url|gh:owner/repo> [asset-regex] [binary-name] [dest-path]"
[ $# -lt 1 ] && {
	echo "$USAGE" >&2
	exit 1
}

SOURCE="$1"
PATTERN="${2:-}"
BIN_NAME="${3:-}"
DEST_PATH="${4:-$HOME/.local/bin}"

# Standard library resolution: $LIB_DIR (set by Make) or the installed path.
# shellcheck source=/dev/null
LIB="${LIB_DIR:-$HOME/.local/lib}/sh/fetch.sh"
[ -f "$LIB" ] || {
	echo "fetch-bin: fetch.sh not found at $LIB (run 'make base' first)" >&2
	exit 1
}
# shellcheck source=/dev/null
. "$LIB"

TMP_DIR=$(mktemp -d -t fetch-bin-XXXXXX)
trap 'rm -rf "${TMP_DIR}"' EXIT

echo ":: Resolving $SOURCE..."
URL=$(fetch_resolve_url "$SOURCE" "$PATTERN")

FILE_NAME=$(basename "${URL%%\?*}")
ARCHIVE="${TMP_DIR}/${FILE_NAME}"

echo ":: Downloading $URL..."
fetch_download "$URL" "$ARCHIVE"

EXTRACT_DIR="${TMP_DIR}/extracted"

echo ":: Extracting $FILE_NAME..."
fetch_extract "$ARCHIVE" "$EXTRACT_DIR"

# Determine target binary name
if [ -z "$BIN_NAME" ]; then
	case "$SOURCE" in
	gh:*)
		BIN_NAME=$(basename "${SOURCE#gh:}")
		;;
	*)
		BIN_NAME=$(basename "$FILE_NAME" | sed -E 's/\.(tar\.(gz|xz|zst|bz2)|zip|bz2|gz)$//')
		;;
	esac
fi

FOUND_BIN=""

# 1. Prefer an exact name match anywhere in the archive.
if [ -n "$BIN_NAME" ]; then
	FOUND_BIN=$(find "$EXTRACT_DIR" -type f -name "$BIN_NAME" | LC_ALL=C sort | head -n 1)
fi

# 2. Otherwise require exactly one candidate: an executable file if the
#    archive marks any, else the archive's only regular file. Archives with
#    several plausible files fail loudly with the candidate list.
if [ -z "$FOUND_BIN" ]; then
	CANDIDATES=$(find "$EXTRACT_DIR" -type f -perm -u+x | LC_ALL=C sort)
	[ -n "$CANDIDATES" ] || CANDIDATES=$(find "$EXTRACT_DIR" -type f | LC_ALL=C sort)

	if [ -z "$CANDIDATES" ]; then
		echo "fetch-bin: no regular files found in archive" >&2
		exit 1
	fi

	COUNT=$(printf '%s\n' "$CANDIDATES" | grep -c .)

	if [ "$COUNT" -eq 1 ]; then
		FOUND_BIN=$CANDIDATES
	else
		echo "fetch-bin: ambiguous archive; specify [binary-name] explicitly:" >&2
		printf '%s\n' "$CANDIDATES" | sed 's/^/  /' >&2
		exit 1
	fi
fi

# Install to destination
mkdir -p "$(dirname "$DEST_PATH")"

if [ -d "$DEST_PATH" ]; then
	TARGET="${DEST_PATH%/}/${BIN_NAME}"
else
	TARGET="$DEST_PATH"
fi

cp -f "$FOUND_BIN" "$TARGET"
chmod 755 "$TARGET"

echo "✓ Successfully installed $TARGET"
