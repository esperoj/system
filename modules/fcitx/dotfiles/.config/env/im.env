# The input-method environment, exported by .profile's env loader
# (set -a) and by .xsessionrc into X sessions. These are the variables
# the GTK, Qt and SDL toolkits (and XIM clients through XMODIFIERS)
# look for; the SDL entry covers the emulators' games.
GTK_IM_MODULE=fcitx
QT_IM_MODULE=fcitx
XMODIFIERS=@im=fcitx
SDL_IM_MODULE=fcitx
