# completion — the bash-completion installer, with the tools replaced
# by mock binaries so no fetch ever happens.

load 'test_helper'

setup() {
	sandbox
	mocks
}

@test "completion: rclone and restic completions are generated by the tools" {
	printf '#!/bin/sh\nprintf "rclone-completion\\n"\n' >"$MOCKS/rclone"
	chmod +x "$MOCKS/rclone"
	cat >"$MOCKS/restic" <<'EOF'
#!/bin/sh
if [ "$1" = generate ] && [ "$2" = --bash-completion ]; then
	printf 'restic-completion\n' >"$3"
fi
EOF
	chmod +x "$MOCKS/restic"
	run completion rclone restic
	[ "$status" -eq 0 ]
	[ "$(cat "$XDG_DATA_HOME/bash-completion/completions/rclone")" = "rclone-completion" ]
	[ "$(cat "$XDG_DATA_HOME/bash-completion/completions/restic")" = "restic-completion" ]
}

@test "completion: git fetches the file for the installed version" {
	cat >"$MOCKS/git" <<'EOF'
#!/bin/sh
printf 'git version 2.47.0\n'
EOF
	chmod +x "$MOCKS/git"
	cat >"$MOCKS/curl" <<'EOF'
#!/bin/sh
# test mock: `curl ... -o FILE ...` writes a fixed payload to FILE
while [ $# -gt 0 ]; do
	if [ "$1" = "-o" ]; then
		printf 'git-completion\n' >"$2"
		shift 2
	else
		shift
	fi
done
EOF
	chmod +x "$MOCKS/curl"
	run completion git
	[ "$status" -eq 0 ]
	[ "$(cat "$XDG_DATA_HOME/bash-completion/completions/git")" = "git-completion" ]
}

@test "completion: tools without a generator skip loudly" {
	printf '#!/bin/sh\nexit 0\n' >"$MOCKS/sometool"
	chmod +x "$MOCKS/sometool"
	run completion sometool
	[ "$status" -eq 0 ]
	case "$output" in
	*"no bash generator"*) ;;
	*) return 1 ;;
	esac
	[ ! -e "$XDG_DATA_HOME/bash-completion/completions/sometool" ]
}

@test "completion: tools not on PATH skip loudly" {
	run completion nosuchtool
	[ "$status" -eq 0 ]
	case "$output" in
	*"not on PATH"*) ;;
	*) return 1 ;;
	esac
}

@test "completion: a failing generator warns, never aborts" {
	cat >"$MOCKS/rclone" <<'EOF'
#!/bin/sh
echo "boom" >&2
exit 1
EOF
	chmod +x "$MOCKS/rclone"
	run completion rclone
	[ "$status" -eq 0 ]
	case "$output" in
	*"generator failed"*) ;;
	*) return 1 ;;
	esac
	[ ! -e "$XDG_DATA_HOME/bash-completion/completions/rclone" ]
}
