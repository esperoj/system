#!/bin/sh
# bootstrap - zero-to-Make host primer.
#
# Runs before anything is installed, so it points PATH and LIB_DIR at the
# repo copies — the same contract the Makefile uses later — and then
# delegates every package concern to install-sys-pkg (the single system
# package installer) and hands off to GNU make.
#
# Privilege is install-sys-pkg's problem, stated once there: root or Termux
# install directly, sudo that validates non-interactively (`sudo -n -v`)
# prefixes the command, and a rootless host without make fails here with a
# clear message instead of a cryptic one.
#
# Layering (see README, Commissioning):
#   bootstrap <profile>  -> tools only; no secrets needed or touched
#   make vault            -> secrets, once the vault has arrived
set -eu

cd "$(dirname "$0")"
export LIB_DIR="$PWD/modules/lib/dotfiles/.local/lib"
export PATH="$PWD/modules/bin/dotfiles/.local/bin:$PATH"

# FreeBSD ships BSD make as 'make'; GNU make is 'gmake'.
if [ "$(uname -s)" = "FreeBSD" ]; then
	MAKE_BIN="gmake"
else
	MAKE_BIN="make"
fi

if ! command -v "$MAKE_BIN" >/dev/null 2>&1; then
	echo ":: $MAKE_BIN not found; asking install-sys-pkg to provide it..."
	install-sys-pkg "$MAKE_BIN"
	command -v "$MAKE_BIN" >/dev/null 2>&1 || {
		echo "bootstrap: the host must provide GNU make ('$MAKE_BIN');" >&2
		echo "bootstrap: ask the admin, or install it manually and re-run." >&2
		exit 1
	}
fi

echo ":: bootstrap complete; handing off to '$MAKE_BIN $*'"
exec "$MAKE_BIN" "$@"
